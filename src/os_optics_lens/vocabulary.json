      "front": "front_camera",
      "main": "main_camera",
      "tele": "telephoto",
      "ultra_wide": "ultrawide"
    }
  },
  "ambiguous": {
    "design_type": {
      "objective": ["endoscope_objective", "microscope_objective"]
    }
  },
  "lens_type_mapping": {
    "camera": {"design_type": "camera_lens"},
    "camera_cooke": {"design_type": "camera_lens"},
    "camera_lens": {"design_type": "camera_lens"},
    "camera_tessar": {"design_type": "camera_lens"},
    "cell_phone": {"design_type": "camera_lens", "application": ["mobile_imaging"]},
    "endoscope_objective": {"design_type": "endoscope_objective", "application": ["endoscopy"]},
    "microscope_objective": {"design_type": "microscope_objective"},
    "stereo_microscope_obj": {"design_type": "microscope_objective", "application": ["microscopy"]},
    "wide_view": {"design_type": "camera_lens"}
  },
  "design_type_functions": {
    "camera_lens": ["imaging"],
    "endoscope_objective": ["imaging"],
    "microscope_objective": ["imaging"]
  },
  "stop_dependent": {
    "description": "Facts whose value depends on a light-blocking stop. Every member of these sections is stop-dependent unless listed in stop_independent.",
    "sections": ["aperture"],
    "facts": ["performance.mtf", "performance.mtf_field_minimum", "performance.relative_illumination"]
  },
  "stop_independent": ["aperture.property_list_comparison", "aperture.stop_opening_diameter_mm"],
  "fact_extraction": {
    "fact_sections": ["aperture", "cost_proxy", "design", "field", "first_order", "image_format"],
    "special_sections": ["analysis_evidence", "performance", "spectrum"],
    "non_fact_sections": [
      "approximations",
      "collection",
      "configuration",
      "configurations",
      "conversion",
      "materials",
      "native_project",
      "record_hash",
      "record_hash_method",
      "record_id",
      "record_revision",
      "record_schema_version",
      "schema",
      "title",
      "unsupported_constructs",
      "validation"
    ],
    "check_members": ["catalog_comparison", "catalog_comparisons", "engine_check", "prescription_dump_check", "property_list_comparison"],
    "skip_members": [
      "application_tags",
      "band_facets",
      "basis",
      "condition",
      "conditions",
      "consequence",
      "definition",
      "format_facets",
      "function_tags",
      "note",
      "notes",
      "source",
      "source_locator",
      "structure_tags",
      "wavelength_precision"
    ],
    "skip_suffixes": ["_basis"]
  }
}
