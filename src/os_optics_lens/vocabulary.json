{
  "vocabulary_version": "1",
  "term_normalization": "Terms and aliases are matched case-insensitively after replacing spaces and hyphens with underscores.",
  "facets": {
    "collection": {
      "level": "record",
      "controlled": false,
      "description": "Collection the record belongs to (collection.collection_id)."
    },
    "family": {
      "level": "record",
      "controlled": false,
      "description": "Design family grouping meaningful variants of one design (design.design_family_id)."
    },
    "design_scope": {
      "level": "record",
      "controlled": true,
      "description": "Whether the prescription is a complete system, a lens group or a singlet (design.design_scope)."
    },
    "design_type": {
      "level": "record",
      "controlled": true,
      "warn_unknown": true,
      "description": "Kind of prescription, mapped from the source lens type (design.lens_type) by this vocabulary."
    },
    "source_lens_type": {
      "level": "record",
      "controlled": false,
      "description": "The source's own lens type label, verbatim (design.lens_type)."
    },
    "function": {
      "level": "record",
      "controlled": true,
      "warn_unknown": true,
      "description": "What the prescription does to light (design.function_tags; imaging is mapped from an imaging design type when no tags are given)."
    },
    "application": {
      "level": "record",
      "controlled": true,
      "warn_unknown": true,
      "description": "Documented use of the design (design.application_tags plus mappings from the source lens type)."
    },
    "structure": {
      "level": "record",
      "controlled": true,
      "warn_unknown": true,
      "description": "Supported optical layout or property (design.structure_tags)."
    },
    "band": {
      "level": "configuration",
      "controlled": true,
      "warn_unknown": true,
      "description": "Spectral band label derived from the sampling wavelengths (spectrum.band_facets). Discovery only: it never confirms spectral coverage."
    },
    "image_format": {
      "level": "configuration",
      "controlled": true,
      "warn_unknown": true,
      "description": "Nominal image format label (image_format.format_facets). Use image_format dimensions and the image circle for coverage checks."
    },
    "conjugate": {
      "level": "configuration",
      "controlled": true,
      "description": "Object and image conjugates of the configuration (design.conjugate)."
    },
    "field_kind": {
      "level": "configuration",
      "controlled": true,
      "description": "How the design file states its field: angular, object height or image height (field.kind)."
    },
    "system_aperture": {
      "level": "configuration",
      "controlled": false,
      "description": "Name of the aperture fact the design file declares as its system aperture (aperture.<name>.system_aperture true)."
    },
    "module_role": {
      "level": "record",
      "controlled": true,
      "warn_unknown": true,
      "description": "Where a phone module sits in its device (design.module_role); not a statement about what the prescription is."
    },
    "stop_state": {
      "level": "record",
      "controlled": true,
      "description": "Whether the Project's stop blocks light (design.aperture_validity.state)."
    },
    "evidence": {
      "level": "configuration",
      "controlled": false,
      "description": "Condition-specific evidence present in the configuration: each performance metric and each analysis study (<study>_study)."

    }
  },
  "terms": {
    "design_scope": ["complete_system", "lens_group", "singlet"],
    "design_type": [
      "beam_expander",
      "camera_lens",
      "collector",
      "collimator",
      "condenser",
      "endoscope_objective",
      "eyepiece",
