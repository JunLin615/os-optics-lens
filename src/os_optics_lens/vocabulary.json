      "visible"
    ],
    "image_format": ["aps_c", "full_frame"],
    "module_role": ["front_camera", "main_camera", "telephoto", "ultrawide"],
    "conjugate": ["finite_to_finite", "finite_to_infinite", "infinite_to_finite", "infinite_to_infinite"],
    "field_kind": ["angular", "image_height", "object_height"],
    "stop_state": ["no_stop", "stop_blocking", "stop_not_blocking"]
  },
  "aliases": {
    "application": {
      "cell_phone": "mobile_imaging",
      "mobile": "mobile_imaging",
      "phone": "mobile_imaging",
      "smartphone": "mobile_imaging"
    },
